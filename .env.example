# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# --- PostgreSQL (Docker) ---
POSTGRES_USER=xiaoxin
# Chỉ dùng chữ + số (nằm trong URL kết nối)
POSTGRES_PASSWORD=doi-mat-khau-db
POSTGRES_DB=xiaoxin
POSTGRES_HOST_PORT=5433

# --- Server ---
# Dùng khi chạy server trên máy (npm run dev:server); trong Docker tự trỏ vào service db
DATABASE_URL=postgres://xiaoxin:doi-mat-khau-db@127.0.0.1:5433/xiaoxin
PORT=3001
APP_PORT=8080

# --- Tài khoản đăng nhập ---
APP_USERNAME=
APP_PASSWORD=
# Chuỗi ngẫu nhiên >= 32 ký tự: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# true khi chạy sau HTTPS
COOKIE_SECURE=false
