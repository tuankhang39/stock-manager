{
  "name": "xiaoxin-stock",
  "private": true,
  "version": "1.0.0",
  "description": "XiaoxinStock — quản lý tồn BHLĐ",
  "author": "XiaoxinStock",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "tsx watch server/index.ts",
    "db:up": "docker compose up -d db",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node22 --external:pg-native --outfile=server-dist/index.cjs",
    "start": "node server-dist/index.cjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "keys:gen": "node scripts/generate-keys.mjs",
    "keys:append": "node scripts/generate-keys.mjs --append 5"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.3",
    "vitest": "^5.1.1"
  }
}
